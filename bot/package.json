{
  "name": "bot",
  "version": "1.0.0",
  "description": "Bot Discord auto-hébergé pour DiscordLink V2",
  "main": "dist/index.js",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "build": "pnpm run clean && pnpm run typecheck && esbuild src/index.ts --bundle --platform=node --target=node20 --external:bufferutil --external:utf-8-validate --outfile=dist/index.js",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "discordlink",
    "minecraft",
    "discord.js"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}